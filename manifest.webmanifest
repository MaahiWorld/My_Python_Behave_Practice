{
  "name": "GoalScope – Live Football Goal Predictor",
  "short_name": "GoalScope",
  "description": "Scan live football matches and predict whether more goals are coming.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1220",
